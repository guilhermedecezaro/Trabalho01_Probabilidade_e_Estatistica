# P1
import random

tamanho_universo = int(input("Digite o tamanho do universo: "))
tamanho_A = int(input("Digite a quantidade de elementos de A: "))
tamanho_B = int(input("Digite a quantidade de elementos de B: "))
tamanho_C = int(input("Digite a quantidade de elementos de C: "))

universo = []
for i in range(1, tamanho_universo + 1):
    universo.append(i)

A = random.sample(universo, tamanho_A)
B = random.sample(universo, tamanho_B)
C = random.sample(universo, tamanho_C)

uniao_AB = []
for x in universo:
    if x in A or x in B:
        uniao_AB.append(x)

inter_AB = []
for x in universo:
    if x in A and x in B:
        inter_AB.append(x)

inter_AC = []
for x in universo:
    if x in A and x in C:
        inter_AC.append(x)

complemento_A = []
for x in universo:
    if x not in A:
        complemento_A.append(x)


print("A =", sorted(A))
print("B =", sorted(B))
print("C =", sorted(C))
print()
print("1) A U B =", uniao_AB)
print("2) A ∩ B =", inter_AB)
print("3) A ∩ C =", inter_AC)
print("4) A^c =", complemento_A)